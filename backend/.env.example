# HypoGuard AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Notification Provider ─────────────────────────────────────────────
# Set to "twilio" to enable caregiver SMS alerts.
# Set to "none" or leave empty to disable (default).
NOTIFICATION_PROVIDER=none

# Twilio credentials (required when NOTIFICATION_PROVIDER=twilio)
# Obtain from: https://console.twilio.com/
NOTIFICATION_API_KEY=
NOTIFICATION_API_SECRET=

# Twilio phone number in E.164 format (e.g. +1XXXXXXXXXX)
NOTIFICATION_FROM_NUMBER=
